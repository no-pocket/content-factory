{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-anchored advisory critique response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "uncertainty",
    "suggestions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "suggestions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reason",
              "evidence",
              "source_start",
              "source_end"
            ],
            "properties": {
              "kind": {
                "const": "BOUNDARY"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment_id",
                    "quote"
                  ],
                  "properties": {
                    "segment_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                }
              },
              "source_start": {
                "type": "number",
                "minimum": 0
              },
              "source_end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reason",
              "evidence",
              "framing"
            ],
            "properties": {
              "kind": {
                "const": "FRAMING"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment_id",
                    "quote"
                  ],
                  "properties": {
                    "segment_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                }
              },
              "framing": {
                "$ref": "./timeline.schema.json#/properties/framing"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "reason",
              "evidence",
              "title"
            ],
            "properties": {
              "kind": {
                "const": "TITLE"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "segment_id",
                    "quote"
                  ],
                  "properties": {
                    "segment_id": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  }
                }
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        ]
      }
    }
  }
}
