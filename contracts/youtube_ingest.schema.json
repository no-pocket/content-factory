{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized YouTube Creator Clip Ingest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_url",
    "creator",
    "license_note",
    "rights_confirmed",
    "platform_permission"
  ],
  "properties": {
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "license_note": {
      "type": "string",
      "minLength": 1
    },
    "rights_confirmed": {
      "const": true
    },
    "platform_permission": {
      "const": true
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outro_asset_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-zA-Z0-9_-]{1,50}$",
          "default": null
        },
        "editorial_protocol": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "default": 1
        },
        "clip_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "target_seconds": {
          "type": "integer",
          "minimum": 8,
          "maximum": 180
        },
        "min_seconds": {
          "type": "integer",
          "minimum": 8,
          "maximum": 180
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 8,
          "maximum": 180
        },
        "proposal_max_chunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "shortlist": {
          "type": "integer",
          "minimum": 3,
          "maximum": 32
        },
        "ollama_timeout": {
          "type": "integer",
          "minimum": 15,
          "maximum": 600
        },
        "whisper_model": {
          "enum": [
            "tiny",
            "base",
            "small",
            "medium",
            "large-v3-turbo",
            "large-v3"
          ]
        },
        "whisper_beam_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "ranker_mode": {
          "enum": [
            "ollama",
            "heuristic"
          ]
        },
        "llm_backend": {
          "enum": [
            "ollama",
            "kepler_gpu"
          ]
        },
        "director_mode": {
          "enum": [
            "ollama",
            "heuristic"
          ]
        },
        "render_engine": {
          "enum": [
            "remotion",
            "ffmpeg"
          ]
        },
        "llm_model": {
          "type": "string",
          "enum": [
            "qwen2.5:1.5b",
            "qwen2.5:3b"
          ],
          "default": "qwen2.5:3b"
        },
        "render_quality": {
          "type": "string",
          "enum": [
            "standard",
            "high"
          ],
          "default": "high"
        },
        "framing_preset": {
          "enum": [
            "legacy",
            "face",
            "gameplay",
            "web",
            "tweet",
            "document"
          ],
          "default": "legacy"
        },
        "framing_roi": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 1000
            }
          ]
        },
        "timeline_v3": {
          "type": "boolean",
          "default": false
        },
        "framing_windows": {
          "type": "array",
          "maxItems": 24,
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "retrieval_mode": {
          "enum": [
            "off",
            "lexical"
          ],
          "default": "off"
        },
        "retrieval_dataset_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$",
          "default": null
        },
        "duration_mode": {
          "type": "string",
          "enum": [
            "classic",
            "flexible"
          ],
          "default": "classic",
          "description": "Flexible: shortest complete relevant story; target is guidance. New jobs only. Source window up to 180 seconds, plus finishing/outro."
        }
      },
      "oneOf": [
        {
          "properties": {
            "duration_mode": {
              "enum": [
                "classic"
              ]
            },
            "target_seconds": {
              "maximum": 60
            },
            "min_seconds": {
              "maximum": 60
            },
            "max_seconds": {
              "minimum": 15,
              "maximum": 60
            }
          }
        },
        {
          "required": [
            "duration_mode"
          ],
          "properties": {
            "duration_mode": {
              "enum": [
                "flexible"
              ]
            }
          }
        }
      ]
    },
    "assembly_plan": {
      "$ref": "./assembly-plan.schema.json"
    }
  }
}
