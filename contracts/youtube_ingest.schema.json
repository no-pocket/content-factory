{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized YouTube Creator Clip Ingest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_url",
    "creator",
    "license_note",
    "rights_confirmed",
    "platform_permission"
  ],
  "properties": {
    "source_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "license_note": {
      "type": "string",
      "minLength": 1
    },
    "rights_confirmed": {
      "const": true
    },
    "platform_permission": {
      "const": true
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editorial_protocol": {
          "type": "integer",
          "enum": [
            1,
            2
          ],
          "default": 1
        },
        "clip_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "target_seconds": {
          "type": "integer",
          "minimum": 8,
          "maximum": 60
        },
        "min_seconds": {
          "type": "integer",
          "minimum": 8,
          "maximum": 60
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 60
        },
        "proposal_max_chunks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "shortlist": {
          "type": "integer",
          "minimum": 3,
          "maximum": 32
        },
        "ollama_timeout": {
          "type": "integer",
          "minimum": 15,
          "maximum": 600
        },
        "whisper_model": {
          "enum": [
            "tiny",
            "base",
            "small",
            "medium",
            "large-v3-turbo",
            "large-v3"
          ]
        },
        "whisper_beam_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "ranker_mode": {
          "enum": [
            "ollama",
            "heuristic"
          ]
        },
        "llm_backend": {
          "enum": [
            "ollama",
            "kepler_gpu"
          ]
        },
        "director_mode": {
          "enum": [
            "ollama",
            "heuristic"
          ]
        },
        "render_engine": {
          "enum": [
            "remotion",
            "ffmpeg"
          ]
        },
        "llm_model": {
          "type": "string",
          "enum": [
            "qwen2.5:1.5b",
            "qwen2.5:3b"
          ],
          "default": "qwen2.5:3b"
        },
        "render_quality": {
          "type": "string",
          "enum": [
            "standard",
            "high"
          ],
          "default": "high"
        },
        "framing_preset": {
          "enum": [
            "legacy",
            "face",
            "gameplay",
            "web",
            "tweet",
            "document"
          ],
          "default": "legacy"
        },
        "framing_roi": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 1000
            }
          ]
        }
      }
    }
  }
}
