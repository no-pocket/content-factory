    "/v1/jobs/upload": {
      "post": {
        "summary": "Create a job from a streamed video up to 2 GiB",
        "parameters": [
          {
            "name": "X-Content-Factory-Metadata",
            "in": "header",
            "required": true,
            "description": "Base64 of UTF-8 JSON matching UploadMetadata; no source_url/upload_base64",
            "schema": {
              "type": "string",
              "maxLength": 49152
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Exactly one Content-Length, 1..2147483648 bytes. Chunked transfer is not supported.",
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
