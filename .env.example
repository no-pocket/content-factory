WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_MODEL=base

# OFF by default. Enable only with platform authorization plus copyright-holder permission.
ENABLE_YOUTUBE_DOWNLOAD=false
YOUTUBE_MAX_DURATION=7200
YOUTUBE_MAX_BYTES=1500000000

# Optional free local language model: first install via docker compose --profile local-ai up -d ollama
# and docker compose exec ollama ollama pull qwen2.5:3b
CLIP_RANKER=ollama
EDIT_DIRECTOR=ollama
RENDER_ENGINE=remotion
RENDER_FALLBACK_FFMPEG=true
RENDER_TIMEOUT=900
WHISPER_BEAM_SIZE=5
# Whisper small improves ASR at higher CPU/VRAM cost; base is lightweight.
WHISPER_INITIAL_PROMPT=GTA VI, Rockstar Games, Vice City, Lucia, Jason, Leonida.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=180
OLLAMA_PROPOSAL_MAX_CHUNKS=12

# Optional Quadro K4200 / CUDA 10.2 Qwen backend (compose.kepler.yaml).
# The UI selects CPU or GPU for each job; these values tune the GPU server.
KEPLER_CTX_SIZE=4096
KEPLER_BATCH_SIZE=512
KEPLER_UBATCH_SIZE=256
KEPLER_GPU_LAYERS=99
KEPLER_THREADS=4
KEPLER_REQUEST_TIMEOUT=300
KEPLER_CONTEXT_MARGIN=16
# Optional private editorial review. Keep dry-run until destinations and transport are authorized.
CONTENT_FACTORY_TELEGRAM_MODE=dry-run
CONTENT_FACTORY_TELEGRAM_DESTINATIONS=
CONTENT_FACTORY_TELEGRAM_ACTORS=
