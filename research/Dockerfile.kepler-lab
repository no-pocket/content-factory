FROM nvcr.io/nvidia/cuda:10.2-devel-ubuntu18.04 AS cuda102

FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-14 cmake ninja-build git ca-certificates libgomp1 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=cuda102 /usr/local/cuda-10.2 /usr/local/cuda-10.2
COPY --from=cuda102 /usr/include/cublas* /usr/local/cuda-10.2/include/
COPY --from=cuda102 /usr/lib/x86_64-linux-gnu/libcublas* /usr/local/cuda-10.2/lib64/
ENV CUDA_HOME=/usr/local/cuda-10.2 \
    PATH=/usr/local/cuda-10.2/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda-10.2/lib64
WORKDIR /src
